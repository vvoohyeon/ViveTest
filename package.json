{
  "name": "vivetest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "sync": "vite-node -c ./vitest.config.ts scripts/sync/sync.ts",
    "sync:dry": "vite-node -c ./vitest.config.ts scripts/sync/sync-dry-run.ts",
    "qa:rules": "node scripts/qa/run-all.mjs",
    "qa:static": "npm run lint && npm run typecheck && npm run qa:rules",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "PLAYWRIGHT_SERVER_MODE=preview playwright test --grep @smoke",
    "qa:gate:once": "npm run qa:static && npm run build && npm run test && npm run test:e2e:smoke",
    "qa:gate": "npm run qa:gate:once && npm run qa:gate:once && npm run qa:gate:once"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "googleapis": "171.4.0",
    "motion": "12.34.0",
    "next": "16.2.4",
    "next-intl": "4.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "4.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.0",
    "dotenv": "^17.4.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.1.6",
    "jsdom": "27.0.1",
    "tailwindcss": "4.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
